            " [74974 70994 44541 65920 56531 31585 33943 53939 49457 31021 41653 73573]\n",
            " [43417 82995 70757 39692 75758 36873 35675 30161 67065 56557 63763 62606]\n",
            " [41534 59127 70397 55851 31016 54253 85591 54276 53247 54300 38529 47262]\n",
            " [39268 51271 42185 51243 69099 38571 87836 69976 68044 81214 79216 78984]]\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "Q1 = sales[:, 0:3]\n",
        "Q2 = sales[:, 3:6]\n",
        "Q3 = sales[:, 6:9]\n",
        "Q4 = sales[:, 9:12]\n",
        "\n",
        "print(\"Q1 shape:\", Q1.shape)\n",
        "print(\"Q1 total per store:\", Q1.sum(axis=1))\n",
        "\n",
        "# Individual stores\n",
        "store_3 = sales[3, :]          # all months for store 3\n",
        "print(\"\\nStore 3 full year:\", store_3)\n",
        "\n",
        "# A store within a quarter, and a month across all stores\n",
        "print(\"Store 3, Q2:\", sales[3, 3:6])\n",
        "print(\"All stores, March:\", sales[:, 2])\n",
        "\n",
        "# reshape trick: split 12 months into (4 quarters x 3 months)\n",
        "by_quarter = sales.reshape(N_STORES, 4, 3)       # (stores, quarter, month-in-quarter)\n",
        "quarterly_totals = by_quarter.sum(axis=2)        # (10, 4)\n",
        "print(\"\\nQuarterly totals (stores x Q1..Q4):\")\n",
        "print(quarterly_totals)"
      ],
      "metadata": {
        "colab": {
