    },
    {
      "cell_type": "code",
      "source": [
        "picked_stores = [1, 4, 7]\n",
        "print(\"Stores 1, 4, 7:\")\n",
        "print(sales[picked_stores])\n",
        "\n",
        "# Best 3 months by total sales across all stores\n",
        "month_totals = sales.sum(axis=0)\n",
        "best3 = np.argsort(month_totals)[-3:][::-1]      # indices, highest first\n",
        "print(\"\\nBest 3 months:\", month_names[best3], \"->\", month_totals[best3])\n",
        "\n",
        "# Combine: picked stores x best months using np.ix_\n",
        "print(\"\\nStores [1,4,7] in the best 3 months:\")\n",
        "print(sales[np.ix_(picked_stores, best3)])\n",
        "\n",
        "# Best month for every store (one index per row)\n",
        "best_month_per_store = sales.argmax(axis=1)\n",
        "print(\"\\nBest month per store:\", month_names[best_month_per_store])"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "2bGJwQa3df_7",
        "outputId": "3c100566-b3c4-4c91-cabd-c5bae4e1fc72"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Stores 1, 4, 7:\n",
            "[[77191 74131 46023 71090 31685 30769 89735 86101 32433 35311 67819 69188]\n",
            " [33556 33890 71606 60740 44502 51777 40627 38792 73323 73021 38433 73001]\n",
            " [43417 82995 70757 39692 75758 36873 35675 30161 67065 56557 63763 62606]]\n",
            "\n",
            "Best 3 months: ['Feb' 'Nov' 'Aug'] -> [644957 615618 614158]\n",
            "\n",
