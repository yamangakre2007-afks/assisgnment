            " [132724 158913 225856 239414]]\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "TARGET = 60_000\n",
        "\n",
        "# Months with sales > target\n",
        "above_target = sales > TARGET\n",
        "print(\"Store-months above target:\", above_target.sum(), \"of\", sales.size)\n",
        "\n",
        "# Stores below average (average of store totals)\n",
        "store_totals = sales.sum(axis=1)\n",
        "below_avg_stores = store_totals < store_totals.mean()\n",
        "print(\"Stores below average:\", stores[below_avg_stores])\n",
        "\n",
        "# --- Combined conditions ---\n",
        "# AND (&): below-average stores that still beat the target in a month\n",
        "below_avg_grid = below_avg_stores[:, None]       # (10,1) broadcasts across months\n",
        "mask_and = above_target & below_avg_grid\n",
        "print(\"\\nBelow-avg stores hitting target (store, month):\")\n",
        "for s, m in zip(*np.where(mask_and)):\n",
        "    print(f\"  Store {s}, {month_names[m]}: ${sales[s, m]:,}\")\n",
        "\n",
        "# OR (|): H2 months OR sales over target\n",
        "h2 = months > 6\n",
        "mask_or = above_target | h2                      # (10,12) | (12,) broadcasts\n",
        "print(\"\\nCells matching (above target OR H2):\", mask_or.sum())\n",
        "\n",
        "# NOT (~): months that missed target\n",
        "missed = ~above_target\n",
        "print(\"Months that missed target:\", missed.sum())\n",
        "\n",
        "# Using a mask to pull values out\n",
        "print(\"\\nFirst 10 sales values over target:\", sales[above_target][:10])"
      ],
      "metadata": {
