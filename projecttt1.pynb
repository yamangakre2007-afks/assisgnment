            "[[74131 67819 86101]\n",
            " [33890 38433 38792]\n",
            " [82995 63763 30161]]\n",
            "\n",
            "Best month per store: ['Jan' 'Jul' 'Oct' 'Feb' 'Sep' 'Nov' 'Jan' 'Feb' 'Jul' 'Jul']\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "monthly_avg = sales.mean(axis=0)\n",
        "growth_targets = np.linspace(monthly_avg[0], monthly_avg[0] * 1.20, N_MONTHS)\n",
        "\n",
        "print(\"=\" * 62)\n",
        "print(f\"{'MONTHLY REPORT':^62}\")\n",
        "print(\"=\" * 62)\n",
        "print(f\"{'Month':<6}{'Avg Sales':>12}{'Target':>12}{'Gap':>12}  Status\")\n",
        "for i in range(N_MONTHS):\n",
        "    gap = monthly_avg[i] - growth_targets[i]\n",
        "    status = \"HIT\" if gap >= 0 else \"MISS\"\n",
        "    print(f\"{month_names[i]:<6}{monthly_avg[i]:>12,.0f}{growth_targets[i]:>12,.0f}{gap:>12,.0f}  {status}\")\n",
        "\n",
        "print()\n",
        "print(\"=\" * 62)\n",
        "print(f\"{'STORE-WISE REPORT':^62}\")\n",
        "print(\"=\" * 62)\n",
        "store_avg = sales.mean(axis=1)\n",
        "company_avg = store_avg.mean()\n",
        "print(f\"{'Store':<7}{'Total':>12}{'Avg/Mo':>12}{'vs Avg':>10}  Best Month\")\n",
        "for s in stores:\n",
        "    diff = (store_avg[s] / company_avg - 1) * 100\n",
        "    print(f\"{s:<7}{store_totals[s]:>12,}{store_avg[s]:>12,.0f}{diff:>9.1f}%  {month_names[best_month_per_store[s]]}\")\n",
        "\n",
        "print()\n",
        "print(\"=\" * 62)\n",
        "print(f\"{'QUARTERLY REPORT':^62}\")\n",
        "print(\"=\" * 62)\n",
        "q_company = quarterly_totals.sum(axis=0)\n",
        "for q in range(4):\n",
        "    top_store = quarterly_totals[:, q].argmax()\n",
        "    print(f\"Q{q+1}: total ${q_company[q]:>10,} | top store: {top_store} (${quarterly_totals[top_store, q]:,})\")"
      ],
      "metadata": {
        "id": "8sR59PkCdkKk"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def query(sales, min_sales=None, max_sales=None, stores=None, months=None):\n",
        "    \"\"\"Return (store_idx, month_idx, value) for cells matching ALL given filters.\n",
        "    months are 1-12, stores are 0-based row ids.\"\"\"\n",
        "    mask = np.ones_like(sales, dtype=bool)\n",
        "    if min_sales is not None:\n",
        "        mask &= sales >= min_sales\n",
        "    if max_sales is not None:\n",
        "        mask &= sales <= max_sales\n",
        "    if stores is not None:\n",
        "        mask &= np.isin(np.arange(sales.shape[0]), stores)[:, None]\n",
        "    if months is not None:\n",
        "        mask &= np.isin(np.arange(1, sales.shape[1] + 1), months)[None, :]\n",
        "    s_idx, m_idx = np.where(mask)\n",
        "    return s_idx, m_idx, sales[s_idx, m_idx]\n",
        "\n",
        "# Example: stores 1, 4, 7 in Q4 with sales over 70k\n",
        "s_idx, m_idx, vals = query(sales, min_sales=70_000, stores=[1, 4, 7], months=[10, 11, 12])\n",
        "print(f\"{len(vals)} matches\")\n",
        "for s, m, v in zip(s_idx, m_idx, vals):\n",
        "    print(f\"  Store {s} | {month_names[m]} | ${v:,}\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
