    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "\n",
        "np.random.seed(42)  # reproducible results\n",
        "np.set_printoptions(suppress=True, linewidth=120)"
      ],
      "metadata": {
        "id": "Lcib1SfOdU3q"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "N_STORES, N_MONTHS = 10, 12\n",
        "\n",
        "months = np.arange(1, 13)                       # month labels 1..12\n",
        "month_names = np.array([\"Jan\",\"Feb\",\"Mar\",\"Apr\",\"May\",\"Jun\",\n",
        "                        \"Jul\",\"Aug\",\"Sep\",\"Oct\",\"Nov\",\"Dec\"])\n",
        "stores = np.arange(N_STORES)                    # store ids 0..9\n",
        "\n",
        "# Random base sales per store/month (in dollars)\n",
        "sales = np.random.randint(30_000, 90_000, size=(N_STORES, N_MONTHS))\n",
        "\n",
        "print(\"months:\", months)\n",
        "print(\"sales shape:\", sales.shape)\n",
        "print(sales)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "0KtLStGydVry",
        "outputId": "e90f4cd3-9fb7-4b54-dbd3-8cf2f9469871"
